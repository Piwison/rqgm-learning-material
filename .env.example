# Supabase — Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Notion — notion.so/my-integrations
# Remember: also add the integration to the [PF] Tasks Database page
# via ⋯ → Connections, or the API returns 404.
NOTION_TOKEN=
NOTION_TASKS_DB_ID=

# Judge model — MUST be a different family from the generator.
# See CLAUDE.md rule 1. Decision: OpenAI GPT family (Gemini is an acceptable
# substitute). Never Claude — that is the one wrong answer.
#
# Put whichever model ID is current when you create the key. Do not treat this
# value as the record of what judged a run — agent_runs.model_used is.
JUDGE_API_KEY=
JUDGE_MODEL=
